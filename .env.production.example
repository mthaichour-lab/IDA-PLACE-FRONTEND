# IDA Place frontend - variables de PRODUCTION (lues au moment du `next build` :
# elles sont inlinées dans le bundle, les changer impose de reconstruire l'image).
# `next build` échoue si l'une de ces règles n'est pas respectée
# (voir config/build-env.ts) :
#  - NEXT_PUBLIC_AUTH_MODE=keycloak ;
#  - NEXT_PUBLIC_API_URL et NEXT_PUBLIC_KEYCLOAK_URL en https:// ;
#  - NEXT_PUBLIC_DEV_USER absent.

NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_API_URL=https://api.ida-place.example
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.ida-place.example
NEXT_PUBLIC_KEYCLOAK_REALM=ida-place
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ida-place-web
