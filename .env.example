# IDA Place frontend - variables d'environnement
# Copier en .env.local et adapter.

# URL du back-end NestJS (sans slash final), préfixe /api/v1 déjà inclus
# côté client HTTP (voir src/lib/api-client.ts).
NEXT_PUBLIC_API_URL=http://localhost:3001

# En-tête d'authentification de développement envoyé par le client HTTP
# (voir DevAuthProvider côté backend). JAMAIS utilisé en production.
NEXT_PUBLIC_DEV_USER=OPERATEUR_PLACE
