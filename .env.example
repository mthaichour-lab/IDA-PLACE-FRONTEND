# IDA Place frontend - variables d'environnement de DÉVELOPPEMENT
# Copier en .env.local et adapter. Pour la production, voir
# .env.production.example (le build de production refuse cette configuration).

# URL du back-end NestJS (sans slash final), préfixe /api/v1 déjà inclus
# côté client HTTP (voir src/lib/api-client.ts). En production : https://
# obligatoire (le WebSocket temps réel passe alors en wss://).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mode d'authentification : "keycloak" (OIDC Authorization Code + PKCE) ou
# "dev" (en-tête x-dev-user, accepté par le backend hors production
# uniquement). Le mode "dev" est IMPOSSIBLE dans un build de production :
# `next build` échoue, et son code est retiré du bundle.
NEXT_PUBLIC_AUTH_MODE=dev

# Mode "dev" uniquement : rôle simulé (nom de rôle, ex. CORRESPONDANT_IDA,
# ou JSON {"role":"TRESORIER","companyId":"CAAT"}). Défaut : OPERATEUR_PLACE.
# Ne JAMAIS définir pour un build de production (le build échoue).
NEXT_PUBLIC_DEV_USER=OPERATEUR_PLACE

# Mode "keycloak" : serveur Keycloak, realm et client public (PKCE).
# NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# NEXT_PUBLIC_KEYCLOAK_REALM=ida-place
# NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ida-place-web
